# Based on Anthropic Claude Code Execution sandbox environment
# Pin the base image for reproducibility. For a fully reproducible, tamper-evident
# build, override with the digest in CI:
#   --build-arg UBUNTU_REF=ubuntu:24.04@sha256:<digest>
# (Left as the tag by default so security rebuilds of 24.04 are still picked up.)
ARG UBUNTU_REF=ubuntu:24.04
FROM ${UBUNTU_REF}

LABEL description="Capka AI Agent Sandbox"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ---------------------------------------------------------------------------
# 0. apt resilience (ports.ubuntu.com is flaky on arm64)
# ---------------------------------------------------------------------------
# The arm64 base image resolves apt to ports.ubuntu.com — a single community
# mirror that regularly times out under load, unlike the fast amd64 mirror. A
# bare `apt-get update` then dies with "connection timed out", and every later
# `apt-get install` fails with "Unable to locate package". Retry each fetch and
# cap the per-attempt timeout so a hung connection retries fast instead of
# burning apt's ~120s default. Written to apt.conf.d so EVERY apt invocation —
# including Playwright's internal `install --with-deps` — inherits it.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' \
    > /etc/apt/apt.conf.d/80-retries

# ---------------------------------------------------------------------------
# 1. Base system packages
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bc bzip2 ca-certificates curl diffutils file findutils \
    git gnupg2 grep gzip hostname lsb-release make mawk \
    netcat-openbsd patch procps sed sensible-utils shared-mime-info \
    tar unzip util-linux wget xz-utils zip \
    iptables \
    build-essential pkg-config \
    python3 python3-dev python3-pip python3-venv python3-setuptools python-is-python3 \
    # Modern, token-efficient CLIs for the agent. ripgrep+fd+sqlite mirror
    # Anthropic's own code-execution sandbox baseline; jq/sd/gron let the agent
    # query & transform structured output instead of dumping blobs into context.
    ripgrep fd-find jq sd gron sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    # fd-find installs the binary as `fdfind` on Debian/Ubuntu (name clash with
    # another package); give the agent the `fd` it expects.
    && ln -sf "$(command -v fdfind)" /usr/local/bin/fd \
    # iptables backend: Ubuntu 24.04 defaults `iptables` to the nft backend, which
    # gVisor (runsc — the secure profile's runtime) does NOT implement at all
    # ("Failed to initialize nft: Protocol not supported"). gVisor's netstack only
    # speaks the LEGACY xtables interface, so the egress firewall in
    # sandbox-entrypoint.sh — which is fail-closed and kills the container if a rule
    # can't be installed — only works when iptables points at the legacy backend.
    # (The legacy table also needs CAP_NET_RAW, which runsc strips unless installed
    # with --net-raw=true; see scripts/install-gvisor.sh.)
    && update-alternatives --set iptables /usr/sbin/iptables-legacy \
    && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy

# ---------------------------------------------------------------------------
# 3. Node.js 22
# ---------------------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 4. Media, graphics, document conversion
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg imagemagick graphviz \
    pandoc \
    # ghostscript is the PS/EPS interpreter and the PDF recompress/rasterize
    # backend that neither poppler nor qpdf provides; ocrmypdf reaches for it too.
    poppler-utils qpdf ghostscript \
    # aria2: resumes a large download instead of restarting it from zero.
    # 7zip: office users send .7z, which unzip cannot open at all.
    aria2 7zip \
    libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw \
    libreoffice-core libreoffice-common python3-uno \
    # -ukr is not a nice-to-have: Ukrainian is a first-class locale and this image
    # shipped English-only. -eng/-osd do arrive as Depends of tesseract-ocr, but
    # both are named anyway so an upstream change can't silently drop a language.
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-osd tesseract-ocr-ukr \
    # xvfb/xauth only. Xvfb depends on libxfont2, NOT on the legacy core-font
    # packages that used to be listed here; LibreOffice and Chromium both resolve
    # fonts through fontconfig, so those were ~30 MB serving nothing.
    xvfb xauth \
    # No TeX Live. It cost ~300 MB, and over half of that arrived UNNAMED:
    # texlive-xetex pulls texlive-latex-extra, which pulls texlive-pictures
    # (82 + 81 MB). pandoc's PDF path now runs through typst (§7b, ~17 MB) with
    # weasyprint as the HTML/CSS alternative. Anything expecting a literal
    # pdflatex/xelatex binary will no longer build here.
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 5. Fonts
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-dejavu fonts-dejavu-core fonts-dejavu-extra \
    fonts-liberation fonts-liberation2 fonts-freefont-ttf \
    # fonts-noto-core (43 MB), not fonts-noto-cjk (91 MB): the latter bought CJK
    # coverage this audience rarely needs while leaving Latin/Cyrillic to DejaVu.
    # CJK text in a document now renders as tofu — deliberate, revisit if it bites.
    fonts-noto-core fonts-noto-color-emoji \
    fonts-crosextra-caladea fonts-crosextra-carlito \
    fonts-lmodern fonts-texgyre fonts-opensymbol \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -fv

# ---------------------------------------------------------------------------
# 6. Python packages
# ---------------------------------------------------------------------------
# --no-binary imageio-ffmpeg: its wheel bundles a private ~49 MB ffmpeg build
# alongside the system ffmpeg installed above. Building from sdist skips the
# binary; IMAGEIO_FFMPEG_EXE (below) points the library at the real one.
ENV IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
RUN pip install --break-system-packages --no-cache-dir --no-binary imageio-ffmpeg \
    # Data science
    numpy pandas scipy scikit-learn scikit-image \
    matplotlib seaborn plotly sympy networkx \
    # ML / CV. onnxruntime looks orphaned — nothing here imports it directly — but
    # it is load-bearing: markitdown requires magika, magika requires onnxruntime,
    # and the model ships INSIDE the magika wheel, so grepping this file for a
    # model finds nothing. Removing it breaks document->markdown conversion.
    onnxruntime opencv-python-headless \
    pillow Wand imageio imageio-ffmpeg \
    # PDF arsenal
    pypdf pikepdf pdfplumber pdfminer.six \
    # No tabula-py (it needed a 195 MB JVM to duplicate camelot/pdfplumber) and no
    # pdfkit: pdfkit only wraps wkhtmltopdf, which was deliberately dropped for its
    # CVSS-9.8 SSRF and replaced by the html2pdf shim (§8b). It was installed but
    # died on every call with "No wkhtmltopdf executable found" — worse than absent,
    # because the agent saw an importable module and spent a turn on it.
    camelot-py pdf2image img2pdf reportlab \
    # ocrmypdf: puts a searchable text layer INTO the original scan, where a raw
    # tesseract pass rebuilds the PDF and loses its metadata.
    ocrmypdf \
    # Documents
    python-docx python-pptx openpyxl xlsxwriter odfpy \
    # Office inputs nothing else here can open: password-protected documents and
    # Outlook .msg files.
    msoffcrypto-tool extract-msg \
    # Tabular. The image had NO parquet engine at all — pandas 3 ships without
    # pyarrow, so a .parquet dropped into a chat was simply unreadable. polars and
    # the duckdb MODULE (the CLI in §7b is a separate thing) also handle files
    # larger than memory; fastparquet is pandas' engine at a fraction of pyarrow's
    # size, and python-calamine reads big/legacy Excel far faster than openpyxl.
    polars duckdb fastparquet python-calamine \
    # weasyprint: HTML/CSS -> PDF for real layouts, and pandoc's non-TeX PDF path.
    weasyprint \
    # Web / HTML
    flask requests beautifulsoup4 httpx lxml jinja2 \
    # Markdown. The EXTRAS are the point: bare `markitdown` installs a converter
    # that refuses every office format at runtime with MissingDependencyException
    # ("include the optional dependency [docx]") — measured, and easy to miss
    # because the import succeeds and only .convert() fails. Named extras rather
    # than [all], which drags in azure-ai-documentintelligence, azure-identity,
    # speechrecognition and youtube-transcript-api for no use here. Of the deps
    # they pull, only mammoth/xlrd/olefile are actually new; the rest are already
    # installed above and the extras merely declare them.
    "markitdown[docx,xlsx,xls,pptx,pdf,outlook]" markdownify \
    # OCR
    pytesseract \
    # Browser
    playwright \
    # Utils
    cryptography pyyaml python-dotenv tabulate chardet psutil \
    yt-dlp graphviz \
    # uv/uvx — runs Python-based stdio MCP servers (e.g. `uvx some-mcp-server`)
    uv

# ---------------------------------------------------------------------------
# 7. Node.js global packages
# ---------------------------------------------------------------------------
# PUPPETEER_SKIP_DOWNLOAD stops @mermaid-js/mermaid-cli's bundled puppeteer from
# pulling its OWN ~640 MB Chrome into /root/.cache — at runtime it reuses the
# single Playwright Chromium via PUPPETEER_EXECUTABLE_PATH (set in §8). Playwright
# is NOT installed here; §8 pins it to the exact pip version so both share one
# browser build instead of silently drifting apart.
ENV PUPPETEER_SKIP_DOWNLOAD=1
RUN npm install -g \
    typescript tsx ts-node \
    @mermaid-js/mermaid-cli \
    sharp pdf-lib docx pptxgenjs \
    marked \
    && npm cache clean --force

# ---------------------------------------------------------------------------
# 7b. Modern static-binary CLIs not in apt (arch-aware)
# ---------------------------------------------------------------------------
# duckdb: in-process SQL over CSV/Parquet/JSON — the agent analyses data files
#   and returns only the rows it needs instead of loading everything.
# yq (mikefarah, Go): the REAL yq — Ubuntu's apt `yq` is an unrelated Python
#   jq-wrapper with different syntax, so we fetch the upstream binary by hand.
# Pinned to explicit versions (was `latest/download`, which made every rebuild
# pull a different, unrecorded binary — a non-reproducible supply-chain hole).
# Bump these deliberately when upgrading.
# typst: pandoc's PDF engine now that TeX Live is gone (`--pdf-engine=typst`).
#   One static binary against ~300 MB of texlive, and markedly faster.
ARG DUCKDB_VERSION=v1.5.4
ARG YQ_VERSION=v4.53.3
ARG TYPST_VERSION=v0.15.1
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    # typst publishes by Rust target triple, not by Debian arch name.
    case "$arch" in amd64) triple=x86_64-unknown-linux-musl;; arm64) triple=aarch64-unknown-linux-musl;; \
      *) echo "no typst build for $arch" >&2; exit 1;; esac; \
    curl -fsSL "https://github.com/typst/typst/releases/download/${TYPST_VERSION}/typst-${triple}.tar.xz" -o /tmp/typst.tar.xz; \
    tar -xJf /tmp/typst.tar.xz -C /tmp; \
    install -m 755 "/tmp/typst-${triple}/typst" /usr/local/bin/typst; \
    rm -rf /tmp/typst.tar.xz "/tmp/typst-${triple}"; \
    curl -fsSL "https://github.com/duckdb/duckdb/releases/download/${DUCKDB_VERSION}/duckdb_cli-linux-${arch}.zip" -o /tmp/duckdb.zip; \
    unzip -d /usr/local/bin /tmp/duckdb.zip; rm /tmp/duckdb.zip; chmod 755 /usr/local/bin/duckdb; \
    curl -fsSL "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${arch}" -o /usr/local/bin/yq; \
    chmod 755 /usr/local/bin/yq

# ---------------------------------------------------------------------------
# 8. Playwright + Chromium (one shared browser for Python AND Node)
# ---------------------------------------------------------------------------
# The Python (pip) and Node (npm) Playwright packages each pin an EXACT Chromium
# build; if their versions drift, one downloads a build the other lacks and then
# silently fails at launch ("Run playwright install"). So read the version pip
# resolved, pin npm to the SAME one, and install the browser ONCE — both runtimes
# resolve to it via PLAYWRIGHT_BROWSERS_PATH. npm's own browser download is
# skipped; the Python installer fetches the single shared build (+ system deps).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
# Global npm modules aren't on Node's default resolution path, so a bare
# `require("playwright")` from /workspace fails — NODE_PATH fixes that.
ENV NODE_PATH=/usr/lib/node_modules
RUN set -eux; \
    PWVER="$(python3 -c 'import importlib.metadata as m; print(m.version("playwright"))')"; \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g "playwright@${PWVER}"; \
    npm cache clean --force; \
    python3 -m playwright install --with-deps chromium; \
    rm -rf /var/lib/apt/lists/*; \
    # The agent expects a `chromium` command, not a version-buried Playwright
    # path — symlink the resolved binary onto PATH and reuse it for puppeteer.
    CHROME="$(python3 -c 'from playwright.sync_api import sync_playwright; p=sync_playwright().start(); print(p.chromium.executable_path); p.stop()')"; \
    # A WRAPPER, not a symlink. The container drops ALL capabilities and sets
    # no-new-privileges, so Chrome's own zygote sandbox cannot initialize at all —
    # it dies with "FATAL ... No usable sandbox!" on every launch. The container IS
    # the sandbox (see the same reasoning already applied to html2pdf below), so the
    # flags belong on the entry point rather than on each caller that remembers them.
    # This also fixes mermaid-cli: PUPPETEER_EXECUTABLE_PATH points here, and its
    # bundled puppeteer launches with default args, so `mmdc` produced NOTHING
    # before. Playwright is unaffected — it invokes the real binary in
    # /opt/pw-browsers directly and passes its own arguments.
    for name in chromium chromium-browser; do \
      printf '#!/bin/sh\nexec "%s" --no-sandbox --disable-dev-shm-usage "$@"\n' "$CHROME" > "/usr/local/bin/$name"; \
      chmod 755 "/usr/local/bin/$name"; \
    done; \
    rm -rf /root/.cache
# mermaid-cli's puppeteer drives the same single Chromium instead of its own copy.
ENV PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chromium

# ---------------------------------------------------------------------------
# 8b. On-demand X server for GUI tools + modern HTML->PDF
# ---------------------------------------------------------------------------
# LibreOffice needs an X server to render, but most sandbox sessions never touch
# it. Instead of a persistent Xvfb burning ~170 MB in EVERY container (idle or
# not), shim its binaries on PATH so each invocation spins up a private,
# throwaway X server via `xvfb-run` and tears it down after. /usr/local/bin
# precedes /usr/bin in PATH, so `soffice` typed in the agent's shell hits the
# shim transparently. `xvfb-run -a` auto-picks a free display; `-e /dev/stderr`
# surfaces its log to the caller instead of a tempfile.
RUN set -eux; \
    for pair in "soffice:/usr/bin/soffice" "libreoffice:/usr/bin/libreoffice"; do \
      name="${pair%%:*}"; real="${pair#*:}"; \
      printf '#!/bin/sh\nexec xvfb-run -a -e /dev/stderr -s "-screen 0 1920x1080x24 -nolisten tcp" "%s" "$@"\n' "$real" > "/usr/local/bin/$name"; \
      chmod 755 "/usr/local/bin/$name"; \
    done

# html2pdf: modern HTML->PDF via headless Chromium, replacing the archived,
# CVSS-9.8-SSRF wkhtmltopdf. Chromium is already in the image and runs headless
# (no X needed). --no-sandbox/--disable-dev-shm-usage are the correct flags
# under gVisor (Chrome's own sandbox is redundant there; /dev/shm is tiny).
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      '# Usage: html2pdf <input.html|url> [output.pdf]' \
      'set -e; src="$1"; [ -n "$src" ] || { echo "usage: html2pdf <input.html|url> [output.pdf]" >&2; exit 2; }' \
      'case "$src" in http://*|https://*|file://*) url="$src";; *) url="file://$(realpath "$src")";; esac' \
      'out="${2:-${src%.*}.pdf}"' \
      'exec chromium --headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu --no-pdf-header-footer --print-to-pdf="$out" "$url"' \
      > /usr/local/bin/html2pdf; \
    chmod 755 /usr/local/bin/html2pdf

# pandoc's DEFAULT --pdf-engine is pdflatex, which this image no longer ships, so
# the most ordinary command here (`pandoc notes.md -o notes.pdf`) would fail on a
# bare install. Shim it the same way §8b shims soffice: inject an engine only when
# the caller asked for a PDF and named none, so an explicit --pdf-engine still wins.
#
# weasyprint, NOT typst, and the reason is a trap: Ubuntu 24.04 ships pandoc 3.1.3,
# which LISTS typst in --list-output-formats yet, given --pdf-engine=typst, renders
# an intermediate *HTML* file and feeds that to typst — it dies with
# "while calling `conf` at toPdfViaTempFile...html". The typst writer only became
# usable later. So the capability probe answers "yes" and proves nothing; measured,
# weasyprint is the engine that actually produces a PDF on this pandoc. typst stays
# in the image as a standalone typesetter (it compiles its own .typ files fine).
# Revisit if pandoc is ever fetched from upstream instead of apt.
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      'engine=""; pdf=""' \
      'for a in "$@"; do' \
      '  case "$a" in --pdf-engine|--pdf-engine=*) engine=1 ;; *.pdf) pdf=1 ;; esac' \
      'done' \
      '[ -z "$engine" ] && [ -n "$pdf" ] && exec /usr/bin/pandoc --pdf-engine=weasyprint "$@"' \
      'exec /usr/bin/pandoc "$@"' \
      > /usr/local/bin/pandoc; \
    chmod 755 /usr/local/bin/pandoc

# ---------------------------------------------------------------------------
# 9. Non-root user + workspace
# ---------------------------------------------------------------------------
# Ubuntu 24.04 ships with 'ubuntu' user at UID 1000 — rename to 'sandbox'
RUN usermod -l sandbox -d /home/sandbox -m ubuntu 2>/dev/null || true && \
    groupmod -n sandbox ubuntu 2>/dev/null || true

# Separate, unprivileged user (UID 1001) for stdio MCP servers. Running them under
# a different uid than the agent (1000) means agent code can't read an MCP server's
# secret env via /proc/<pid>/environ. A real passwd entry keeps os.userInfo()-style
# lookups from crashing; HOME is overridden to the writable /opt/mcp tmpfs at runtime.
RUN useradd -u 1001 -m -d /home/mcp -s /usr/sbin/nologin mcp

# Entrypoint: repair mount ownership, drop to the sandbox user, then idle.
# (No persistent Xvfb — GUI tools get a throwaway X server on demand; see §8b.)
COPY --chmod=755 sandbox-entrypoint.sh /entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
